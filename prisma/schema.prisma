// This is your Prisma schema file,
// learn more about it in the docs:
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SKIPPED
}

enum TrainingWeekStatus {
  ACTIVE
  COMPLETED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String

  timezone      String   @default("Asia/Almaty")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exercises          UserExercise[]
  workouts           Workout[]
  trainingWeeks      TrainingWeek[]
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model Exercise {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  createdAt     DateTime @default(now())

  userExercises UserExercise[]
  workouts      Workout[]
  trainingWeeks TrainingWeek[]
}

model UserExercise {
  id           String    @id @default(cuid())
  userId       String
  exerciseId   String
  maxReps      Int?
  maxUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}

model TrainingWeek {
  id          String             @id @default(cuid())
  userId      String
  exerciseId  String
  weekNumber  Int
  maxReps     Int

  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date

  status      TrainingWeekStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workouts Workout[]

  @@unique([userId, exerciseId, weekNumber])
  @@index([userId, status])
  @@index([userId, exerciseId, status])
}

model Workout {
  id             String        @id @default(cuid())
  trainingWeekId String
  userId         String
  exerciseId     String
  workoutNumber  Int

  scheduledDate  DateTime      @db.Date

  status         WorkoutStatus @default(PLANNED)
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  trainingWeek TrainingWeek @relation(fields: [trainingWeekId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise      Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets          WorkoutSet[]

  @@unique([trainingWeekId, workoutNumber])
  @@unique([userId, exerciseId, scheduledDate])
  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([exerciseId])
  @@index([trainingWeekId])
}

model WorkoutSet {
  id          String   @id @default(cuid())
  workoutId   String
  setNumber   Int
  targetReps  Int
  actualReps  Int?
  completed   Boolean  @default(false)
  completedAt DateTime?

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, setNumber])
  @@index([workoutId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}